{
  "name": "career-portfolio-template",
  "version": "1.0.0",
  "description": "A free Next.js personal portfolio and digital CV starter, with interactive project stories and optional contact and booking integrations.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": ">=22.15.0"
  },
  "scripts": {
    "dev": "node scripts/prepare-portrait.mjs && next dev",
    "build": "node scripts/prepare-portrait.mjs && next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:unit": "node --experimental-strip-types --import ./tests/helpers/register-typescript.mjs --test \"tests/unit/*.test.mjs\"",
    "test:e2e": "playwright test",
    "check:content": "node --experimental-strip-types scripts/check-content.mjs",
    "check": "pnpm typecheck && pnpm lint && pnpm test:unit && pnpm build"
  },
  "dependencies": {
    "framer-motion": "^12.23.12",
    "googleapis": "^173.0.0",
    "lottie-web": "^5.13.0",
    "lucide-react": "^0.554.0",
    "luxon": "^3.7.2",
    "next": "16.3.5",
    "posthog-js": "^1.430.3",
    "posthog-node": "^5.52.1",
    "react": "19.1.0",
    "react-dom": "19.1.0"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.5",
    "@next/eslint-plugin-next": "16.3.5",
    "@playwright/test": "^1.61.1",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/luxon": "^3.7.1",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@typescript-eslint/eslint-plugin": "^8.62.0",
    "@typescript-eslint/parser": "^8.62.0",
    "autoprefixer": "^10.4.21",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.0.1",
    "playwright": "^1.61.1",
    "sharp": "0.35.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5"
  },
  "pnpm": {
    "overrides": {
      "@babel/core": "7.29.6",
      "ajv@<6.14.0": "6.14.0",
      "brace-expansion@<1.1.18": "1.1.18",
      "brace-expansion@>=2.0.0 <2.0.3": "2.0.3",
      "brace-expansion@>=5.0.0 <5.0.9": "5.0.9",
      "browserslist@<4.28.7": "4.28.7",
      "flatted@<=3.4.1": "3.4.2",
      "@humanfs/node@<0.16.8": "0.16.8",
      "js-yaml@>=4.0.0 <4.3.2": "4.3.2",
      "minimatch@<3.1.4": "3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "9.0.7",
      "picomatch@<2.3.2": "2.3.2",
      "picomatch@>=4.0.0 <4.0.7": "4.0.7",
      "postcss@<8.5.23": "8.5.23",
      "qs": "6.16.0",
      "baseline-browser-mapping@<2.11.0": "2.11.0"
    }
  }
}
