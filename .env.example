# Copy to .env.local (git-ignored). Leave anything you do not use empty; the site runs
# without services: the contact page offers direct email, and no analytics load.
# Public identity (name, contact address) lives in src/config/site.ts.
# Optional deployment override for site.url (for example a separately hosted demo):
NEXT_PUBLIC_SITE_URL=
# NEXT_PUBLIC_* values are compiled into the browser bundle and are public.
# Everything else is server-only. Never commit real values. See docs/setup.md.

# ---- Contact delivery (Gmail API of the authorised Google account) ----
# The private inbox that receives messages and booking notifications. Required as soon as
# delivery is enabled: there is no built-in fallback, an empty or invalid value makes the
# routes answer "not configured" instead of sending anywhere.
CONTACT_TO_EMAIL=
# Comma-separated addresses that are you; messages/bookings from them skip the owner notification.
SITE_OWNER_EMAIL_ALIASES=

# ---- Google Calendar, Meet and Gmail (booking) ----
# 1. Create an OAuth web-application client in Google Cloud with the Calendar and Gmail APIs enabled.
# 2. Add http://localhost:3000/api/google/oauth/callback as an authorised redirect URI (local setup only).
# 3. Put the client id and secret here, run `pnpm dev` and open http://localhost:3000/api/google/oauth/start once;
#    the helper writes GOOGLE_WORKSPACE_REFRESH_TOKEN and GOOGLE_WORKSPACE_GOOGLE_ACCOUNT_EMAIL into .env.local.
# 4. Copy the three values to your host's server-only environment.
GOOGLE_WORKSPACE_CLIENT_ID=
GOOGLE_WORKSPACE_CLIENT_SECRET=
GOOGLE_WORKSPACE_REFRESH_TOKEN=
GOOGLE_WORKSPACE_GOOGLE_ACCOUNT_EMAIL=
# Calendar to check and write (default: primary).
GOOGLE_WORKSPACE_CALENDAR_ID=
# Organiser time zone for the windows below (default: UTC). Windows keep their wall-clock time across DST.
GOOGLE_WORKSPACE_TIMEZONE=
# Per-weekday windows: 1=Monday … 7=Sunday, HH:MM-HH:MM, several spans per day with ";", days with "|".
# Example: 1=18:30-20:00|2=19:00-20:30|6=12:00-13:00;17:00-18:30   (days not listed have no slots)
GOOGLE_WORKSPACE_DAY_WINDOWS=
# Older grouped form, used only when GOOGLE_WORKSPACE_DAY_WINDOWS is empty
# (defaults: days 2,3,4,5 with 12:00-13:30;16:30-18:00 and days 6,7 with 11:00-16:00).
GOOGLE_WORKSPACE_WEEKDAY_DAYS=
GOOGLE_WORKSPACE_WEEKDAY_WINDOWS=
GOOGLE_WORKSPACE_WEEKEND_DAYS=
GOOGLE_WORKSPACE_WEEKEND_WINDOWS=
# Legacy single window, used only when none of the above is set (defaults: 1,2,3,4,5 / 10:00 / 18:00).
GOOGLE_WORKSPACE_BUSINESS_DAYS=
GOOGLE_WORKSPACE_DAY_START=
GOOGLE_WORKSPACE_DAY_END=
# Slot length in minutes (default 30); the availability response publishes it.
GOOGLE_WORKSPACE_SLOT_MINUTES=
# Earliest bookable slot, hours from now (default 24).
GOOGLE_WORKSPACE_MIN_NOTICE_HOURS=
# Largest date range one availability request may cover, in days (default 62).
GOOGLE_WORKSPACE_MAX_AVAILABILITY_WINDOW_DAYS=
# How far ahead slots may be offered, in days (default 180).
GOOGLE_WORKSPACE_MAX_AVAILABILITY_LOOKAHEAD_DAYS=

# ---- Cloudflare Turnstile (bot check for both forms) ----
# Use a separate widget for localhost and for your domain. In production builds a missing secret or
# hostname list refuses submissions; Cloudflare's testing secrets are refused in production too.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=
# Comma-separated hostnames the widget was issued for, e.g. localhost or www.example.com
TURNSTILE_ALLOWED_HOSTNAMES=

# ---- Redis (rate limits and booking coordination; required in production builds) ----
# Either pair works. The Upstash pair wins when both are set. Keys are scoped by VERCEL_ENV.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ---- Optional analytics (public ingestion configuration only) ----
# Loads only on the production origin (site.url in src/config/site.ts), after the visitor accepts.
NEXT_PUBLIC_POSTHOG_PROJECT_TOKEN=
# Required alongside the token. Only https://eu.i.posthog.com is supported; no host is assumed.
NEXT_PUBLIC_POSTHOG_HOST=
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# ---- Demo mode (public flag; never on a real deployment) ----
# true simulates booking and message delivery: generated availability, a pretend confirmation,
# nothing created or sent, and the bot check is skipped. Used for the template's public demo.
NEXT_PUBLIC_DEMO_MODE=

# VERCEL, VERCEL_ENV and NODE_ENV are set by the platform; do not set them here.
